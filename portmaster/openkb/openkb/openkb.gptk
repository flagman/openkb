[config]
deadzone_triggers = 3000
deadzone_mode = axial
deadzone = 8000
deadzone_scale = 8
deadzone_delay = 16
mouse_scale = 6114
mouse_delay = 16

[controls]
overlay = clear

# D-pad moves the hero and the menu cursor
up = up
down = down
left = left
right = right

# East button confirms, south button backs out. Batocera-based CFWs
# (KNULLI) map the east button to SDL "b" and the south one to "a".
b = enter
a = esc
x = o
y = v

# Hold L1 (Shift for the game) and press the d-pad for diagonal moves;
# the game shows a hint while it is held
l1 = shift
r1 = w

l2 = a
r2 = u

start = enter

left_analog = arrow_keys
right_analog = mouse_movement
l3 = mouse_left
r3 = mouse_left

